# ============================================================================
# GroktoCrawl 全功能单镜像 — 环境变量配置模板
# 使用方法: cp .env.allinone.example .env && 按需修改 → docker compose up -d
#
# 全部变量均可改、均支持热迁移(改后 docker compose up -d 重建容器生效)。
# 未设置的变量走镜像内置默认值, 可零配置先跑起来再逐步定制。
# ============================================================================

# ── 镜像与基础 ────────────────────────────────────────────────────────────
# 镜像标签（镜像仓库固定为 ghcr.io/cshdotcom/groktocrawl-allinone, 改版本改这里）
# TAG=latest
# 时区
TZ=Asia/Shanghai
# 服务日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ── 端口变量 (默认只穿透爬虫后台与门户) ─────────────────────────────────
# 爬虫后台 REST API + Swagger 文档页(/docs) —— 客户端/CLI/穿透全部指向它
AGENT_HOST_PORT=9080
# 爬虫门户 Web UI (单搜索框)
PORTAL_HOST_PORT=9081

# —— 可选穿透端口(改数字即换宿主端口; 是否生效取决于 compose 中对应行是否取消注释)——
# MCP 协议服务器(AI 客户端直连爬虫, 如 Claude/Cursor 等):
# MCP_HOST_PORT=9082
# 以下为容器内部组件的调试端口, 一般保持注释:
# SCRAPER_HOST_PORT=19001      五层爬虫执行器(curl_cffi/Chromium/CloakBrowser)
# BROWSER_HOST_PORT=19012      无头浏览器会话服务
# SEMANTIC_HOST_PORT=19003     语义向量检索(BGE-M3 + rerank)
# PARSE_HOST_PORT=19013        文档解析(PDF/Office/OCR)
# 内嵌搜索 SearXNG 直连(需三步: 开启下行 + compose 取消 SEARXNG_HOST_PORT 映射行
#                      + 下方 SEARXNG_BIND=0.0.0.0):
# SEARXNG_HOST_PORT=19088

# ── 存储位置 (整体搬迁只改 DATA_DIR; 也可在 compose 中逐行覆盖) ──────────
# 数据会分布在: $DATA_DIR/{valkey, qdrant, huggingface, cloakbrowser, config, logs}
# 例: DATA_DIR=/mnt/nas/groktocrawl
DATA_DIR=./groktocrawl-data

# ── AI 大模型 (OpenAI 兼容协议) ───────────────────────────────────────────
# 三项全留空 = 内置离线 fixture LLM, 仅用于零依赖演示。
# 接入真实模型示例:
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   通义千问:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   本地 Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
# 推理模型思考超时(秒), 用 DeepSeek-R1 等推理模型时建议 300
LLM_CALL_TIMEOUT=120
# 是否启用供应商思考模式(DeepSeek/OpenAI o系列等)
LLM_ENABLE_THINKING=false

# ── 搜索引擎 ─────────────────────────────────────────────────────────────
# 默认使用内嵌 SearXNG 聚合引擎, 自动按查询语言匹配结果语言,
# 再叠加 BGE-M3 多语言向量检索与 rerank 做混合排序。
#
# ★ 引擎集默认为「中国大陆直连可达精选集」(无需代理即可搜索):
#   bing / bing news / bing images / bing videos   通用网页·资讯·图·视频
#   github / mdn / microsoft learn / stackoverflow 开发者与 IT
#   arxiv / crossref / semantic scholar / pubmed   学术(零广告)
#   bilibili / chinaso news / sina                 中文垂直源
# 海外服务器或已配代理想恢复全球引擎集: SEARXNG_ENGINES=all
#
# 如想换成外部 SearXNG/SlopSearX 实例, 填写其地址即可自动停用内嵌搜索:
# ⚠️ 不要填旧多镜像容器名(如 http://slopsearx:8080)——会被视为遗留地址自动忽略;
#    外部实例请用 IP/域名, 例: http://192.168.1.10:8888
# SEARXNG_URL=http://your-searxng-host:8888
SEARXNG_URL=
# 强制控制搜索语言(auto=跟随查询语言自动判定); 示例: zh-CN / en / ja
SEARCH_LANGUAGE=auto
# 内嵌搜索监听地址: 默认仅容器内可见; 需从宿主机直连内嵌搜索时改 0.0.0.0,
# 并开启 compose 中 SEARXNG_HOST_PORT 映射行(纯改变量不动 compose 时保持默认即可)
# SEARXNG_BIND=127.0.0.1
# 完全禁用内嵌搜索(true/false/auto): auto=仅当 SEARXNG_URL 为空时启动
EMBED_SEARXNG=auto
# 内嵌搜索进程资源(SEARXNG_WORKERS x SEARXNG_THREADS 并发查询)
SEARXNG_WORKERS=2
SEARXNG_THREADS=12
# 引擎白名单(逗号分隔, 名称同 SearXNG 引擎名):
#   留空 = 用上面的大陆精选集; "all" = 全部默认引擎;
#   指定列表 = 只用这些引擎(会强制启用, 需为 SearXNG 已注册引擎名)
#   例: 想在精选集外补充 mojeek(独立索引, 大陆可达但中文一般):
#   SEARXNG_ENGINES=bing,bing news,bing images,bing videos,github,mdn,microsoft learn,stackoverflow,arxiv,crossref,semantic scholar,pubmed,bilibili,chinaso news,sina,mojeek
SEARXNG_ENGINES=
# 在白名单基础上再剔除的引擎(逗号分隔, 优先级高于白名单):
# SEARXNG_DISABLED_ENGINES=bing images
# 引擎出站代理(可选): 仅 SearXNG 引擎请求走此代理(http/socks5),
# 例: http://192.168.1.10:7890 或 socks5://user:pass@10.0.0.2:1080
# 配置后可恢复 google/duckduckgo 等被墙引擎(SEARXNG_ENGINES=all)
SEARXNG_OUTGOING_PROXY=

# Brave API 密钥(可选): 为聚合搜索增加 Brave 数据源, 同时供 research deep 模式调用
# 注意: search.brave.com 在大陆被墙, 未配置 SEARXNG_OUTGOING_PROXY/系统代理时填了也无效
BRAVE_API_KEY=

# ── API 安全 ─────────────────────────────────────────────────────────────
# 强烈建议公网部署前设置! 之后所有请求需带 Authorization: Bearer <key> 或 X-API-Key
# 生成密钥: openssl rand -hex 32
API_KEY=
# 出站 Webhook 签名密钥(可选)
WEBHOOK_SECRET=

# ── 向量检索(语义搜索) ───────────────────────────────────────────────────
# BGE-M3 是多语言向量模型(1024维), 支持中日韩英跨语言检索 + rerank。
# 首次启动自动从 HuggingFace 下载 ~2.3GB 到 huggingface 目录。
# 国内网络拉取缓慢时可换镜像源:
# HF_ENDPOINT=https://hf-mirror.com
# 更换嵌入模型(需 EMBED_DIM 匹配模型输出维度; 换后建议清空 qdrant 数据目录重建索引):
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024
ACTIVE_EMBED_MODEL=v_bge-m3
# 向量库最大文档数
VECTOR_INDEX_MAX_DOCS=250000
# 接入外部 Qdrant 后自动停用内嵌实例
# ⚠️ 不要填旧多镜像容器名 http://qdrant:6333 —— 会被自动忽略; 外部请用 IP/域名
# QDRANT_URL=http://your-qdrant-host:6333
QDRANT_URL=
EMBED_QDRANT=auto

# ── 缓存/队列(Valkey) ────────────────────────────────────────────────────
# 接入外部 Redis/Valkey 后自动停用内嵌实例, 例: redis://192.168.1.10:6379/0
# ⚠️ 不要填旧多镜像的 redis://valkey:6379/0 —— 会被自动忽略并回退内嵌,
#    否则缓存静默禁用 + analytics 错误刷屏
VALKEY_URL=
EMBED_VALKEY=auto

# ── 爬虫行为 ─────────────────────────────────────────────────────────────
# 出站代理(http/https/socks5, 凭据可含其中; 不可达时 fail-open 继续直连)
SCRAPER_PROXY_URL=
# Playwright 并发生命周期上限(每浏览器多进程, 机器内存紧张就调小)
SCRAPER_MAX_BROWSER_CONCURRENCY=4
# 反爬增强(可选): 外挂 FlareSolverr 专解 Cloudflare 强校验页,
# 需在 compose 中自行追加一个独立 FlareSolverr 服务后填其地址
FLARE_SOLVERR_URL=
# ── 人机验证(验证码)自动恢复 —— 内置能力说明 ────────────────────────────
# 内置恢复模块无需任何配置即可工作, 自动识别并按序尝试:
#   1) 被动等待自动通过  2) 点击复选框(reCAPTCHA / hCaptcha / Cloudflare Turnstile)
# 2 步未过的"图片九宫格"题才会用到下面这个视觉识别端点(OpenAI 兼容多模态模型,
# 三项全填才启用; 与 LLM_API_KEY 相互独立, 配个便宜的多模态模型即可):
CAPTCHA_VISION_BASE_URL=
CAPTCHA_VISION_API_KEY=
CAPTCHA_VISION_MODEL=
# CAPTCHA_VISION_TIMEOUT=60     视觉识别调用超时(秒)
# 全部失败时报 CAPTCHA_UNRESOLVED 并跳过该页; 走 SOCKS/住宅代理可显著降低触发率

# ── 采集质量门阈值(一般不用动) ───────────────────────────────────────────
QA_MIN_CONTENT_CHARS=200
QA_MAX_BOILERPLATE_RATIO=0.7
QA_MIN_QUALITY_THRESHOLD=0.3
SCRAPE_CACHE_TTL=3600

# ── Monitor 定时巡检(替代上游 ofelia 容器) ───────────────────────────────
MONITOR_SCHEDULER_ENABLED=true
MONITOR_INTERVAL_SECONDS=600

# ── 资源限制 ─────────────────────────────────────────────────────────────
# 语义服务加载 BGE-M3 后常驻约 2-3GB; 跑大并发抓取建议提高
MEM_LIMIT=6g

# ── 其他进阶键(.env 中的任何上游变量都会原样传入容器) ───────────────────
# 完整清单参考上游 .env.sample 或文档 docs/guides/deployment.md, 例如:
# AGENT_MAX_SEARCHES_PER_REQUEST=5      单次 answer/research 的最大搜索次数
# AGENT_SEARCH_RATE_LIMIT=10/60s        按 IP 的滑动窗口限流
# JOB_RETRY_MAX_ATTEMPTS=3              下游429任务重试上限
# CRAWL_MAX_DURATION_SECONDS=1800       单次 crawl 任务最长时长
# ADMISSION_LIGHT_FETCH_LIMIT=64        全局准入权重预算(fetch=1 llm=4 browser=8)
